{
  "name": "tubeless",
  "version": "0.3.3",
  "description": "Typed pipelines and bounded conversational workspace agents with inspectable execution graphs.",
  "author": {
    "name": "Chet Mancini",
    "url": "https://github.com/chetmancini"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chetmancini/tubeless.git"
  },
  "homepage": "https://tubeless.io/",
  "bugs": {
    "url": "https://github.com/chetmancini/tubeless/issues"
  },
  "keywords": [
    "pipeline",
    "workflow",
    "agent",
    "repl",
    "interactive",
    "dag",
    "typescript",
    "cli",
    "esm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.6.0",
    "bun": ">=1.3.14"
  },
  "sideEffects": false,
  "type": "module",
  "bin": {
    "tubeless": "./dist/workbench/workbench-bin.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && bun scripts/generate-studio-client.mjs",
    "build:watch": "tsc -p tsconfig.json --watch",
    "api:check": "node scripts/generate-api-reference.mjs --check",
    "api:diff": "node scripts/summarize-api-report-diff.mjs",
    "api:generate": "bun run build && node scripts/generate-api-reference.mjs",
    "studio:check": "bun scripts/generate-studio-client.mjs --check",
    "check": "bun run build && bun dist/workbench/workbench-bin.js run --trace logs/check.ndjson scripts/check-pipeline.ts -- --continue-on-error --max-concurrency 4",
    "docs:check": "node scripts/validate-learning-surface.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "bunx --bun oxlint .",
    "knip": "knip",
    "pack:dry-run": "bun pm pack --dry-run --ignore-scripts",
    "tubeless": "bun run --silent build && bun dist/workbench/workbench-bin.js",
    "prepack": "bun run build",
    "test": "bun run build && bun run test:run",
    "test:run": "vitest run --config vitest.config.ts",
    "test:shard": "vitest run --config vitest.config.ts --shard \"${TEST_SHARD-1/1}\"",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:watch": "vitest --watch --config vitest.config.ts",
    "typecheck": "bun run build && bun run typecheck:run",
    "typecheck:run": "tsc -p tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit && tsc -p tsconfig.automation.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p design/tsconfig.json",
    "pack:verify": "node scripts/verify-packed-artifact.mjs",
    "eval:agent": "bun run build && node scripts/eval-agent.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@dagster-io/dagster-pipes": "0.1.0",
    "@inngest/test": "1.0.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.4",
    "cf": "1.0.0-beta.17",
    "inngest": "4.24.0",
    "knip": "6.41.0",
    "miniflare": "5.20261006.0-alpha",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "preact": "11.0.1",
    "preact-render-to-string": "6.8.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "exports": {
    "./agent/node": {
      "types": "./dist/agent/node.d.ts",
      "import": "./dist/agent/node.js",
      "default": "./dist/agent/node.js"
    },
    "./agent": {
      "types": "./dist/agent/agent.d.ts",
      "import": "./dist/agent/agent.js",
      "default": "./dist/agent/agent.js"
    },
    ".": {
      "types": "./dist/core/pipeline.d.ts",
      "import": "./dist/core/pipeline.js",
      "default": "./dist/core/pipeline.js"
    },
    "./cli": {
      "types": "./dist/cli/cli.d.ts",
      "import": "./dist/cli/cli.js",
      "default": "./dist/cli/cli.js"
    },
    "./batch": {
      "types": "./dist/utilities/batch.d.ts",
      "import": "./dist/utilities/batch.js",
      "default": "./dist/utilities/batch.js"
    },
    "./node": {
      "types": "./dist/node/node.d.ts",
      "import": "./dist/node/node.js",
      "default": "./dist/node/node.js"
    },
    "./rate-limit": {
      "types": "./dist/utilities/rate-limit.d.ts",
      "import": "./dist/utilities/rate-limit.js",
      "default": "./dist/utilities/rate-limit.js"
    },
    "./retry": {
      "types": "./dist/utilities/retry.d.ts",
      "import": "./dist/utilities/retry.js",
      "default": "./dist/utilities/retry.js"
    },
    "./project": {
      "types": "./dist/project/project.d.ts",
      "import": "./dist/project/project.js",
      "default": "./dist/project/project.js"
    },
    "./testing": {
      "types": "./dist/testing/testing.d.ts",
      "import": "./dist/testing/testing.js",
      "default": "./dist/testing/testing.js"
    },
    "./tracing": {
      "types": "./dist/tracing/tracing.d.ts",
      "import": "./dist/tracing/tracing.js",
      "default": "./dist/tracing/tracing.js"
    },
    "./agent/openai": {
      "types": "./dist/agent/openai.d.ts",
      "import": "./dist/agent/openai.js",
      "default": "./dist/agent/openai.js"
    },
    "./agent/anthropic": {
      "types": "./dist/agent/anthropic.d.ts",
      "import": "./dist/agent/anthropic.js",
      "default": "./dist/agent/anthropic.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/cloudflare.d.ts",
      "import": "./dist/cloudflare/cloudflare.js",
      "default": "./dist/cloudflare/cloudflare.js"
    },
    "./cloudflare/cache": {
      "types": "./dist/cloudflare/cloudflare-cache.d.ts",
      "import": "./dist/cloudflare/cloudflare-cache.js",
      "default": "./dist/cloudflare/cloudflare-cache.js"
    }
  }
}
