---
import Rainbow from "../components/Rainbow.astro";
import PostHog from "../components/PostHog.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { href } from "../lib/paths";
import { SOCIAL_IMAGE_ALT, SOCIAL_IMAGE_URL } from "../lib/social-image";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  markdown?: string;
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
};

const { title, description, markdown, structuredData, noindex } = Astro.props;
const pageTitle = title === "Tubeless" ? "Tubeless — Typed pipelines for Node.js" : `${title} · Tubeless`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Tubeless" />
    <link rel="alternate" type="text/plain" title="Agent documentation index" href={href("llms.txt")} />
    <link rel="alternate" type="text/plain" title="Complete documentation" href={href("llms-full.txt")} />
    <meta name="author" content="Chet Mancini" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="describedby" href={href("llms.txt")} />
    <link rel="sitemap" type="application/xml" href={href("sitemap.xml")} />
    {markdown && <link rel="alternate" type="text/markdown" href={href(markdown)} />}
    {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={href("apple-touch-icon.png")} type="image/png" sizes="180x180" />
    <link rel="apple-touch-icon" href={href("apple-touch-icon.png")} sizes="180x180" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tubeless" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SOCIAL_IMAGE_URL} />
    <meta property="og:image:alt" content={SOCIAL_IMAGE_ALT} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SOCIAL_IMAGE_URL} />
    <meta name="twitter:image:alt" content={SOCIAL_IMAGE_ALT} />
    <meta name="theme-color" content="#e6e4de" />
    <meta name="color-scheme" content="light" />
    <PostHog />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="site-top">
      <Rainbow />
      <SiteHeader />
    </div>
    <div id="content">
      <slot />
    </div>
    <SiteFooter />
    <span class="sr-only" role="status" id="copy-status"></span>
    <script>
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest<HTMLButtonElement>("[data-copy]");
        if (!button) return;
        const text = button.dataset.copy;
        if (!text) return;
        const status = document.getElementById("copy-status");
        void Promise.resolve().then(() => navigator.clipboard.writeText(text)).then(() => {
          if (status) status.textContent = "Copied to clipboard.";
          button.dataset.copied = "";
          window.setTimeout(() => {
            delete button.dataset.copied;
          }, 1600);
        }).catch(() => {
          if (status) status.textContent = "Could not copy. Select and copy the text directly.";
        });
      });
    </script>
  </body>
</html>
